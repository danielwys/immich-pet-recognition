# Immich's Compose service name works when both services share a Docker network.
PET_IMMICH_URL=http://immich-server:2283
PET_IMMICH_API_KEY=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PET_SERVICE_TOKEN=
# Set false only when everyone who can reach this service is trusted.
PET_AUTH_REQUIRED=true
PET_AUTO_TAG=false
PET_POLL_SECONDS=300
# Adaptive matching learns a separate boundary for each pet.
PET_MATCHING_MODE=adaptive
# Legacy fixed mode thresholds:
PET_MATCH_THRESHOLD=0.85
PET_MATCH_MARGIN=0.08
PET_MIN_REFERENCES=10
PET_DETECTOR_THRESHOLD=0.5
