FROM ghcr.io/astral-sh/uv:0.12.19 AS uv
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates libgomp1 && \
    rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY scripts ./scripts
RUN uv sync --frozen --no-dev --extra cuda --python /usr/bin/python3 && \
    chmod -R a+rX /app && \
    useradd --uid 10001 --create-home pets && mkdir /data && chown pets:pets /data
ENV PATH="/app/.venv/bin:$PATH" PET_DATA_DIR=/data PYTHONUNBUFFERED=1
USER pets
EXPOSE 8090
CMD ["immich-pets", "--host", "0.0.0.0", "--port", "8090"]
